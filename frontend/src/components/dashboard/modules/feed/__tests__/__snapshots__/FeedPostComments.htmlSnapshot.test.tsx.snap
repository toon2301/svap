                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>
          <div
            class="min-w-0 flex-1 pt-0.5"
          >
            <h2
              class="text-lg font-semibold text-gray-900 dark:text-white"
              id="feed-comment-delete-title"
            >
              Naozaj chcete odstrániť tento komentár?
            </h2>
            <p
              class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400"
            >
              Túto akciu už nie je možné vrátiť späť.
            </p>
          </div>
        </div>
        <div
          class="mt-6 flex justify-end gap-3"
        >
          <button
            class="rounded-lg border border-gray-300 px-4 py-2.5 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 disabled:opacity-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800/50"
            type="button"
          >
            Zrušiť
          </button>
          <button
            class="inline-flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-50"
            data-testid="feed-comment-delete-confirm-action"
            type="button"
          >
            Vymazať
          </button>
        </div>
      </div>
    </div>
  </div>
</body>
`;

